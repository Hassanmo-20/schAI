APP_NAME=schAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated list of frontend origins allowed to call this API (CORS).
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Sanctum API token lifetime in minutes. Leave empty for non-expiring tokens
# (local dev). Set a value in production, e.g. 10080 = 7 days.
SANCTUM_EXPIRATION=

# --- Academic Assistant (OpenAI) -------------------------------------------
# Server-side only: this key is never sent to the browser. Leave empty to run
# SchAI without the assistant — every other feature keeps working and the
# assistant endpoint replies 503 "not configured".
# Get a key at https://platform.openai.com/api-keys — never commit a real one.
OPENAI_API_KEY=
# Default if unset: gpt-4o-mini (cheap, fast, sufficient for this use case).
OPENAI_MODEL=gpt-4o-mini
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=30
# OPENAI_MAX_OUTPUT_TOKENS=700

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
